APP_NAME=GeneMeds
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Preferred: one complete PostgreSQL URL.
# For AWS RDS, sslmode=require is usually the right default.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: build the URL from parts instead of a single string.
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=5432
DATABASE_NAME=genemeds
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_SSLMODE=require
