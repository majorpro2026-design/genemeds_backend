APP_NAME=GeneMeds
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Preferred: one complete PostgreSQL URL.
# For AWS RDS, sslmode=require is usually the right default.
DATABASE_URL=jdbc:postgresql://genemeds.cupgeqgu0vg9.us-east-1.rds.amazonaws.com:5432/genemeds

# Optional: build the URL from parts instead of a single string.
DATABASE_HOST=genemeds.cupgeqgu0vg9.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=genemeds
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSLMODE=require
